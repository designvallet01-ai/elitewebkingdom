{
  "cleanUrls": true,
  "functions": {
    "api/run.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/compilercollegeadmin", "destination": "/compiler/index.html" },
    { "source": "/compilercollegeadmin/", "destination": "/compiler/index.html" },
    { "source": "/compilercollegeadmin/:path*", "destination": "/compiler/index.html" },
    { "source": "/compiler", "destination": "/compiler/index.html" },
    { "source": "/compiler/", "destination": "/compiler/index.html" }
  ]
}
