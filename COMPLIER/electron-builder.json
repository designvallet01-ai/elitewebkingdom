{
  "appId": "in.elitewebkingdom.ide",
  "productName": "Elite IDE",
  "copyright": "Copyright © 2026 Elite Web Kingdom",
  "directories": {
    "output": "../dist-desktop"
  },
  "files": [
    "electron/**/*",
    "server/**/*",
    "src/services/**/*",
    "package.json",
    "build/**/*",
    "public/**/*",
    "../compiler/**/*"
  ],
  "win": {
    "icon": "build/icon.ico",
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": ["**/*"]
      },
      {
        "from": "../compiler",
        "to": "compiler",
        "filter": ["**/*"]
      }
    ],
    "target": [
      {
        "target": "portable",
        "arch": ["x64"]
      },
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ]
  },
  "mac": {
    "icon": "build/icon.png",
    "category": "public.app-category.developer-tools",
    "extraResources": [
      {
        "from": "../compiler",
        "to": "compiler",
        "filter": ["**/*"]
      }
    ],
    "target": [
      {
        "target": "dmg",
        "arch": ["x64", "arm64"]
      },
      {
        "target": "zip",
        "arch": ["x64", "arm64"]
      }
    ],
    "hardenedRuntime": false,
    "gatekeeperAssess": false,
    "identity": null
  },
  "dmg": {
    "artifactName": "Elite-IDE-Offline-v2-Mac-${arch}.dmg",
    "title": "Elite IDE Installer",
    "window": {
      "width": 540,
      "height": 380
    }
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Elite IDE",
    "installerIcon": "build/icon.ico",
    "uninstallerIcon": "build/icon.ico"
  },
  "portable": {
    "artifactName": "Elite-IDE-Offline-v2-Portable.exe"
  },
  "asar": false
}
